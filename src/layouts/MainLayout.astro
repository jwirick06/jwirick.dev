---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Jonathan Wirick: Computer Information Systems student, IT support, and homelab enthusiast in West Kelowna, BC. Open to opportunities.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: headshot, width: 800, height: 800, format: 'jpeg' });
const ogImageURL = new URL(ogImage.src, Astro.site);

const navItems = [
  { label: './home', href: '/' },
  { label: './projects', href: '/projects' },
  { label: './resume', href: '/resume' },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
      <!-- Google tag (gtag.js) -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-SW6PV3MM20"></script>
      <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-SW6PV3MM20');
      </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Jonathan Wirick" />
    <meta name="theme-color" content="#09090b" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jonathan Wirick" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-zinc-950 text-zinc-200 font-sans antialiased min-h-screen flex flex-col">

    <!-- GLOBAL NAVIGATION -->
    <header class="sticky top-0 z-50 w-full bg-zinc-950/90 backdrop-blur border-b border-zinc-800">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <a href="/" class="font-mono font-bold text-lg text-zinc-100 tracking-tight hover:text-accent transition-colors">
          <span class="text-accent">~/</span><span class="hidden sm:inline">jonathan-wirick</span><span class="sm:hidden">jw</span>
        </a>

        <div class="flex items-center gap-4 sm:gap-6">
          <nav class="flex gap-4 sm:gap-8 font-mono text-sm" aria-label="Main navigation">
            {navItems.map((item) => {
              const isActive = Astro.url.pathname === item.href;
              return (
                <a
                  href={item.href}
                  class={`border-b-2 pb-0.5 transition-colors ${isActive ? 'text-accent border-accent' : 'text-zinc-400 border-transparent hover:text-accent'} ${item.href === '/' ? 'hidden sm:inline' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <button
            type="button"
            data-cmdk-open
            aria-label="Open command palette"
            class="inline-flex items-center gap-1.5 rounded border border-zinc-800 bg-zinc-900 px-2 py-1.5 font-mono text-xs text-zinc-400 hover:border-accent-700/60 hover:text-accent transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m20 20-3.5-3.5" />
            </svg>
            <kbd data-cmdk-kbd class="hidden sm:inline not-italic">Ctrl K</kbd>
          </button>
        </div>
      </div>
    </header>

    <!-- CONTENT -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-zinc-950 border-t border-zinc-800 mt-12">
      <div class="max-w-5xl mx-auto px-4 py-8 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex flex-col items-center md:items-start gap-1">
          <p class="font-mono text-xs text-muted">
            <span class="text-accent">//</span> © {new Date().getFullYear()} Jonathan Wirick, built with Astro &amp; Tailwind
          </p>
          <p class="font-mono text-xs text-muted">
            <span class="text-accent">$</span> curl -s jwirick.dev/cv
          </p>
        </div>
        <div class="flex gap-6 font-mono text-sm">
          <a href="https://github.com/jwirick06" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-accent transition-colors">
            [GitHub]
          </a>
          <a href="https://www.linkedin.com/in/jonathan-wirick-6a657b34b/" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-accent transition-colors">
            [LinkedIn]
          </a>
          <a href="mailto:jwirick06@gmail.com" class="text-zinc-400 hover:text-accent transition-colors">
            [Email]
          </a>
        </div>
      </div>
    </footer>


    <CommandPalette />

  </body>
</html>
