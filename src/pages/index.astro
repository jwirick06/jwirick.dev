  <script is:inline>
    // Mirrors ageOn() in this page's frontmatter. Keeps the age right even if
    // the site has not been rebuilt since the last 31 January.
    (function () {
      var el = document.getElementById('age');
      if (!el) return;
      var d = new Date();
      var ticked = d.getMonth() > 0 || (d.getMonth() === 0 && d.getDate() >= 31);
      el.textContent = String(d.getFullYear() - 2006 - (ticked ? 0 : 1));
    })();
  </script>

  <style>
    .term-cursor {
      display: inline-block;
      animation: blink 1s step-end infinite;
      margin-left: 1px;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
  </style>
