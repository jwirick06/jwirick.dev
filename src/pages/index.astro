---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';

/*
 * The neofetch card's "OS" line carries an age that ticks over on 31 January.
 * This is a static build, so the value here is fixed at deploy time. A small
 * inline script at the bottom of the page recomputes it on load, so a build
 * that predates 31 January still shows the right number to a visitor.
 */
const AGE_EPOCH_YEAR = 2006;

function ageOn(d: Date): number {
  const ticked = d.getMonth() > 0 || (d.getMonth() === 0 && d.getDate() >= 31);
  return d.getFullYear() - AGE_EPOCH_YEAR - (ticked ? 0 : 1);
}

const age = ageOn(new Date());

/*
 * Component states. Each state pairs a colour with a glyph AND a written
 * label, so it reads the same in greyscale and to a colour-blind viewer.
 * Only the two colours the site already uses: emerald for operational,
 * accent blue for planned.
 */
const states = {
  operational: {
    label: 'Operational',
    glyph: '\u25cf',
    badge: 'border-emerald-700/40 bg-emerald-950/30 text-emerald-400',
  },
  planned: {
    label: 'Planned change',
    glyph: '\u25c6',
    badge: 'border-accent-700/40 bg-accent-500/10 text-accent',
  },
};

const components = [
  {
    name: 'Service Desk',
    description:
      'Front-line intake, documentation, and prioritization in Ivanti, covering ticketing and asset inventory across 15 city-managed facilities.',
    note: null,
    state: 'operational',
  },
  {
    name: 'Infrastructure',
    description:
      'Permanent home lab: Proxmox VE, LXC containers, Docker Compose services, scheduled backups, and Tailscale remote access.',
    note: 'Windows Server 2025 Hyper-V lab covering AD DS, organizational units, Group Policy, DNS, and domain joins. Running since 2023.',
    state: 'operational',
  },
  {
    name: 'Development',
    description:
      'Personal and course projects in Java, PHP, Dart/Flutter, and JavaScript, versioned in Git with public repositories on GitHub.',
    note: null,
    state: 'operational',
  },
  {
    name: 'Studies',
    description:
      'Diploma of Computer Information Systems, Okanagan College. Coursework complete and program requirements met, conferral pending the graduation audit.',
    note: 'Bachelor of Computer Information Systems, Cybersecurity option, starts Fall 2026. A scheduled move to the next credential.',
    state: 'planned',
  },
];

const badgeBase =
  'inline-flex items-center gap-2 self-start flex-shrink-0 px-2.5 py-1 rounded-full border font-mono text-xs font-medium whitespace-nowrap';
---

<MainLayout
  title="Jonathan Wirick | IT Support & CIS Student"
  description="Computer Information Systems student at Okanagan College. Service desk support at the City of West Kelowna, three years of homelab infrastructure, and full-stack work in Java, PHP, and PostgreSQL. Open to opportunities in West Kelowna, BC."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Jonathan Wirick',
      url: 'https://jwirick.dev',
      email: 'mailto:jwirick06@gmail.com',
      jobTitle: 'Computer Information Systems Student',
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Okanagan College' },
      address: { '@type': 'PostalAddress', addressLocality: 'West Kelowna', addressRegion: 'BC', addressCountry: 'CA' },
      sameAs: [
        'https://github.com/jwirick06',
        'https://www.linkedin.com/in/jonathan-wirick-6a657b34b/',
      ],
      knowsAbout: ['IT Service Desk', 'Ivanti', 'Technical Support', 'Java', 'PHP', 'PostgreSQL', 'JavaScript', 'Docker', 'Linux', 'Proxmox VE', 'System Administration'],
    })}
  />
  <!-- Hero -->
  <section class="relative">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Copy -->
        <div>
          <div class="inline-flex items-center gap-2 mb-6 px-3 py-1.5 border border-emerald-700/40 bg-emerald-950/30 text-emerald-400 rounded font-mono text-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            open to opportunities
          </div>

          <p class="font-mono text-sm text-accent mb-3">$ whoami</p>
          <h1 class="font-mono text-4xl sm:text-5xl font-bold text-zinc-50 tracking-tight mb-4">
            Jonathan Wirick
          </h1>

          <p class="text-lg text-zinc-400 mb-8 leading-relaxed max-w-lg">
            Third-year Computer Information Systems student at <strong class="text-zinc-200 font-semibold">Okanagan College</strong>.
            I've run a <strong class="text-zinc-200 font-semibold">homelab</strong> since 2023, and I ski.
          </p>

          <div class="flex flex-wrap gap-4 mb-8">
            <a
              href="/projects"
              class="group inline-flex items-center gap-1.5 font-mono font-semibold text-sm px-6 py-3 border border-accent text-accent rounded hover:bg-accent hover:text-zinc-950 transition-colors"
            >
              <span>[</span><span>View Projects</span>
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              <span>]</span>
            </a>
            <a
              href="/resume"
              class="group inline-flex items-center gap-1.5 font-mono font-semibold text-sm px-6 py-3 border border-zinc-700 text-zinc-300 rounded hover:border-accent hover:text-accent transition-colors"
            >
              <span>[</span><span>See Resume</span>
              <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              <span>]</span>
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-sm">
            <a href="https://github.com/jwirick06" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-muted hover:text-accent transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              GitHub
            </a>
            <a href="https://www.linkedin.com/in/jonathan-wirick-6a657b34b/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-muted hover:text-accent transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
              </svg>
              LinkedIn
            </a>
            <a href="mailto:jwirick06@gmail.com" class="inline-flex items-center gap-2 text-muted hover:text-accent transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              jwirick06@gmail.com
            </a>
          </div>
        </div>

        <!-- Neofetch-style profile card -->
        <div class="rounded-lg border border-zinc-800 bg-zinc-900 shadow-2xl overflow-hidden hover:border-accent-700/60 transition-colors">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-zinc-800 bg-zinc-900/80">
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
            <span class="ml-2 font-mono text-xs text-muted">jonathan@homelab: neofetch</span>
          </div>
          <div class="p-6 flex flex-col sm:flex-row gap-6 items-start">
            <div class="w-24 h-24 sm:w-28 sm:h-28 flex-shrink-0 rounded-md overflow-hidden border-2 border-accent-700/50">
              <Image
                src={headshot}
                alt="Jonathan Wirick"
                class="w-full h-full object-cover"
                loading="eager"
                quality={90}
                widths={[112, 224]}
                sizes="112px"
              />
            </div>
            <dl class="font-mono text-sm leading-relaxed">
              <dt class="sr-only">Name</dt>
              <dd class="text-zinc-50 font-bold mb-1">jonathan-wirick</dd>
              <div class="h-px w-32 bg-zinc-800 mb-2"></div>
              <div class="flex gap-2"><dt class="text-accent w-[4.5rem] flex-shrink-0">OS</dt><dd class="text-zinc-400">Human.js (v<span id="age">{age}</span>)</dd></div>
              <div class="flex gap-2"><dt class="text-accent w-[4.5rem] flex-shrink-0">Role</dt><dd class="text-zinc-400">CIS Student</dd></div>
              <div class="flex gap-2"><dt class="text-accent w-[4.5rem] flex-shrink-0">Focus</dt><dd class="text-zinc-400">service desk + infrastructure</dd></div>
              <div class="flex gap-2"><dt class="text-accent w-[4.5rem] flex-shrink-0">Uptime</dt><dd class="text-zinc-400">3 yrs homelab</dd></div>
              <div class="flex gap-2">
                <dt class="text-accent w-[4.5rem] flex-shrink-0">Status</dt>
                <dd class="text-emerald-400 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>open<span class="term-cursor">_</span>
                </dd>
              </div>
            </dl>
          </div>
        </div>

      </div>
    </div>

    <!-- Components -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <p class="font-mono text-xs text-accent uppercase tracking-widest mb-2">// components</p>
      <h2 class="font-mono text-2xl sm:text-3xl font-bold text-zinc-50 mb-3">Where things stand</h2>
      <p class="text-zinc-400 leading-relaxed mb-8 max-w-2xl">
        Service desk work, my home lab, code, and school. Three are running as normal. One has a
        change scheduled.
      </p>

      <ul class="rounded-lg border border-zinc-800 bg-zinc-900 divide-y divide-zinc-800 list-none">
        {components.map((component) => {
          const state = states[component.state];
          return (
            <li class="p-4 sm:p-5 hover:bg-accent-500/[0.06] transition-colors">
              <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                <div class="min-w-0">
                  <h3 class="font-mono font-bold text-zinc-100">{component.name}</h3>
                  <p class="text-sm text-zinc-400 leading-relaxed mt-1.5">{component.description}</p>
                  {component.note && (
                    <p class="text-sm text-zinc-400 leading-relaxed mt-1.5">{component.note}</p>
                  )}
                </div>
                <span class:list={[badgeBase, state.badge]}>
                  <span aria-hidden="true">{state.glyph}</span>
                  {state.label}
                </span>
              </div>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- About Me -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <p class="font-mono text-xs text-accent uppercase tracking-widest mb-2">// about</p>
      <h2 class="font-mono text-2xl sm:text-3xl font-bold text-zinc-50 mb-10">
        About Me
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-zinc-900 rounded-lg p-8 border border-zinc-800 hover:border-accent-700/60 transition-colors">
          <h3 class="font-mono text-lg font-bold text-zinc-50 mb-4">How I got here</h3>
          <p class="text-zinc-400 leading-relaxed mb-4">
            I built my first homelab in 2023, a <strong class="text-zinc-200 font-semibold">Proxmox</strong> server running in my room,
            because I wanted to know how the things I used every day actually worked. It is where I learned Linux,
            networking, and containers, on hardware I could break without consequence.
          </p>
          <p class="text-zinc-400 leading-relaxed">
            That turned into a Computer Information Systems diploma at Okanagan College and, this past summer, a term on the
            <strong class="text-zinc-200 font-semibold">service desk at the City of West Kelowna</strong>. I took tickets in Ivanti
            across all 15 city facilities, imaged and deployed hardware, swapped switches and access points, and traced a fault
            in the ticketing system's own back end. Working the queue is where the theory stopped being theory.
          </p>
        </div>

        <div class="bg-zinc-900 rounded-lg p-8 border border-zinc-800 hover:border-accent-700/60 transition-colors">
          <h3 class="font-mono text-lg font-bold text-zinc-50 mb-4">What I work on</h3>
          <p class="text-zinc-400 leading-relaxed mb-4">
            Most of the problems I've run into sit <strong class="text-zinc-200 font-semibold">between the application and the machine it runs on</strong>.
            A PostgreSQL query that won't use its index and a container that won't start are the same
            kind of puzzle, and knowing both sides is what makes either one workable.
          </p>
          <p class="text-zinc-400 leading-relaxed">
            I'm <strong class="text-zinc-200 font-semibold">open to opportunities</strong> in support, infrastructure, and development,
            and I start a Bachelor's with a Cybersecurity option this fall. I'd rather work somewhere that
            expects me to keep learning. Mostly I just enjoy working with people to solve problems using technology.
          </p>
        </div>
      </div>
    </div>

    <!-- Technical Toolkit -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
      <p class="font-mono text-xs text-accent uppercase tracking-widest mb-2">// toolkit</p>
      <h2 class="font-mono text-2xl sm:text-3xl font-bold text-zinc-50 mb-10">Technical Toolkit</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

        <!-- Card 1: Service Desk & Support -->
        <div class="bg-zinc-900 rounded-lg p-8 border border-zinc-800 hover:border-accent-700/60 transition-colors">
          <div class="w-12 h-12 rounded border border-zinc-800 bg-zinc-950 text-accent flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5a9 9 0 0 1 18 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>
          </div>
          <h3 class="font-mono text-base font-bold text-zinc-50 mb-3">Service Desk &amp; Support</h3>
          <p class="text-muted text-sm mb-8 leading-relaxed">
            Taking, triaging, and resolving tickets, then deploying the hardware behind them.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Ivanti</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Incident Triage</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Hardware Imaging</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Deployments</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Asset Audits</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Documentation</span>
          </div>
        </div>

        <!-- Card 2: Development -->
        <div class="bg-zinc-900 rounded-lg p-8 border border-zinc-800 hover:border-accent-700/60 transition-colors">
          <div class="w-12 h-12 rounded border border-zinc-800 bg-zinc-950 text-accent flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3 class="font-mono text-base font-bold text-zinc-50 mb-3">Development</h3>
          <p class="text-muted text-sm mb-8 leading-relaxed">
            Application code and the database schemas underneath it.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Java</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">C#</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">PHP</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">JavaScript</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Dart/Flutter</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">PostgreSQL</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Oracle SQL</span>
          </div>
        </div>

        <!-- Card 3: Infrastructure & Networking -->
        <div class="bg-zinc-900 rounded-lg p-8 border border-zinc-800 hover:border-accent-700/60 transition-colors">
          <div class="w-12 h-12 rounded border border-zinc-800 bg-zinc-950 text-accent flex items-center justify-center mb-6">
