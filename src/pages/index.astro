            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Nginx</span>
            <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 rounded font-mono text-xs">Tailscale</span>
          </div>
        </div>

