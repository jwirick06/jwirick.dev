---
import MainLayout from '../layouts/MainLayout.astro';

import {
  summary,
  skillGroups,
  problemSolving,
  experiences,
  selfDirected,
  projects,
  education,
  additional,
} from '../data/resume';

const headingClass = "font-mono text-xl font-bold text-zinc-50 border-b-2 border-zinc-800 pb-2 mb-4 print:text-black print:border-zinc-300";
const bulletClass = "text-zinc-400 leading-relaxed print:text-zinc-700";
const chipClass = "px-3 py-1 bg-zinc-900 border border-zinc-800 text-zinc-300 rounded-md text-sm font-medium font-mono print:bg-white print:border print:border-zinc-300 print:text-zinc-800";
---

<MainLayout
  title="Resume | Jonathan Wirick"
  description="Resume of Jonathan Wirick: Computer Information Systems student at Okanagan College and service desk support at the City of West Kelowna, with Ivanti, hardware deployment, and infrastructure experience."
>
  <style is:inline>
    @media print {
      @page {
        margin: 0.4in 0.5in;
        size: letter;
      }

      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      /* THE dial for how much fits on the page.
         Every size in this layout comes from a Tailwind utility, and those
         are all in rem, which resolves against the root font size, not the
         body's. So scaling `html` scales type, padding, margins and gaps
         together and the whole resume shrinks proportionally. Setting this
         on `body` instead does almost nothing, because rem ignores it.
         Raise it if the PDF has room left at the bottom; lower it if the
         resume spills onto a second page. */
      html {
        font-size: 8.5pt !important;
      }

      /* The site is dark by default. Force a white page for print. */
      html, body {
        background-color: #ffffff !important;
        color: #18181b !important;
      }

      body {
        font-size: 1rem !important;
        line-height: 1.35 !important;
      }

      header, footer { display: none !important; }
      main { margin: 0 !important; padding: 0 !important; }

      .max-w-4xl {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      /* 2px reads heavy once the type is this small. */
      h2 {
        border-bottom-width: 1px !important;
      }

      .leading-relaxed {
        line-height: 1.4 !important;
      }

      /* A resume wants a tighter vertical rhythm than a web page. These are
         in rem, so they still scale with the root dial above; they only
         change the proportions, not the overall size. */
      .space-y-10 > * + * { margin-top: 0.85rem !important; }
      .space-y-8  > * + * { margin-top: 0.6rem !important; }
      .space-y-6  > * + * { margin-top: 0.5rem !important; }
      .space-y-4  > * + * { margin-top: 0.4rem !important; }
      .resume-bullets > * + * { margin-top: 0.12rem !important; }

      .mb-12 { margin-bottom: 0.7rem !important; }
      .pb-8  { padding-bottom: 0.45rem !important; }
      .mb-6  { margin-bottom: 0.45rem !important; }
      .mb-4  { margin-bottom: 0.4rem !important; }
      .mb-3  { margin-bottom: 0.3rem !important; }
      .mb-2  { margin-bottom: 0.22rem !important; }
      .mb-1  { margin-bottom: 0.12rem !important; }

      h1 { margin-bottom: 0.12rem !important; line-height: 1.15 !important; }
      h2 { padding-bottom: 0.2rem !important; }

      section {
        page-break-inside: avoid;
        break-inside: avoid;
      }

      /* Long sections must be allowed to break; keep individual entries intact */
      section:has(.resume-timeline) {
        page-break-inside: auto;
        break-inside: auto;
      }

      .resume-timeline > li,
      .resume-bullets > li {
        page-break-inside: avoid;
        break-inside: avoid;
      }

      /* Print the timeline as flat entries: no rail, no indent */
      .resume-timeline {
        padding: 0 !important;
        margin: 0 !important;
      }

      .resume-timeline > li {
        display: block !important;
      }

      .resume-timeline .timeline-rail {
        display: none !important;
      }

      .resume-bullets {
        padding-left: 1.1rem !important;
        margin: 0 !important;
      }
    }
  </style>

  <!-- Page Content Container -->
  <div class="max-w-4xl mx-auto px-4 py-12 sm:px-6 lg:px-8 print:p-0">

    <!-- Action Bar-->
    <div class="flex justify-end mb-8 print:hidden">
      <button
        onclick="window.print()"
        class="inline-flex items-center gap-2 border border-accent-700/60 text-accent font-mono text-sm font-medium px-4 py-2 rounded hover:bg-accent hover:text-zinc-950 transition-colors"
      >
        <span>[ Save as PDF ]</span>
      </button>
    </div>

    <!-- Resume Header -->
    <div class="mb-12 border-b border-zinc-800 pb-8 print:border-zinc-300">
      <h1 class="font-mono text-4xl font-bold text-zinc-50 mb-2 print:text-black">Jonathan Wirick</h1>
      <p class="text-xl text-zinc-400 mb-6 print:text-zinc-700">CIS Student | Service Desk &amp; Infrastructure Support</p>

      <div class="flex flex-wrap gap-4 text-sm text-muted font-mono print:text-zinc-600">
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          West Kelowna, BC
        </div>
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          jwirick06@gmail.com
        </div>
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          github.com/jwirick06
        </div>
      </div>
    </div>

    <div class="space-y-10">

      <section>
        <h2 class={headingClass}><span class="text-accent">##</span> Summary</h2>
        <p class={bulletClass}>{summary}</p>
      </section>

      <section>
        <h2 class={headingClass}><span class="text-accent">##</span> Key Skills</h2>
        <div class="space-y-4">
          {skillGroups.map((group) => (
            <div>
              <h3 class="font-mono font-bold text-zinc-100 mb-2 print:text-black">
                <span class="text-accent print:text-accent-700">-</span> {group.label}
              </h3>
              <div class="flex flex-wrap gap-2 print:hidden">
                {group.items.map((item) => (
                  <span class={chipClass}>{item}</span>
                ))}
              </div>
              <p class="hidden print:block print:text-zinc-700">{group.items.join(', ')}</p>
            </div>
          ))}
          <p class:list={[bulletClass, "print:hidden"]}>{problemSolving}</p>
        </div>
      </section>

      <section>
        <h2 class={headingClass}><span class="text-accent">##</span> Work Experience</h2>
        <ol class="resume-timeline space-y-8 list-none">
          {experiences.map((job, index) => (
            <li class="flex gap-4">
              <!-- Rail: marker plus the connecting line to the next entry -->
              <div class="timeline-rail flex flex-col items-center flex-shrink-0 pt-1.5" aria-hidden="true">
                <span
                  class:list={[
                    'w-3 h-3 rounded-full flex-shrink-0',
                    job.period.includes('Present')
                      ? 'bg-accent ring-4 ring-accent-500/15'
                      : 'bg-zinc-950 border-2 border-zinc-700',
                  ]}
                ></span>
                {index < experiences.length - 1 && (
                  <span class="w-px flex-1 bg-zinc-800 mt-2"></span>
                )}
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex justify-between items-baseline gap-3 mb-1">
                  <h3 class="font-bold text-zinc-100 print:text-black">{job.role}</h3>
                  <span class="text-sm text-muted font-mono flex-shrink-0 print:text-zinc-600">{job.period}</span>
                </div>
                <p class="text-zinc-300 font-medium mb-2 print:text-zinc-700">{job.company}</p>
                <ul class="resume-bullets list-disc pl-5 marker:text-zinc-600 space-y-1.5 print:marker:text-zinc-500">
                  {job.bullets.map((bullet, i) => (
                    <li class:list={[bulletClass, i >= job.printBullets && 'print:hidden']}>{bullet}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h2 class={headingClass}><span class="text-accent">##</span> Self-Directed Technical Experience</h2>
        <div class="space-y-6">
          {selfDirected.map((entry) => (
            <div>
              <div class="flex justify-between items-baseline gap-3 mb-2">
                <h3 class="font-bold text-zinc-100 print:text-black">{entry.role}</h3>
                <span class="text-sm text-muted font-mono flex-shrink-0 print:text-zinc-600">{entry.period}</span>
              </div>
              <ul class="resume-bullets list-disc pl-5 marker:text-zinc-600 space-y-1.5 print:marker:text-zinc-500">
                {entry.bullets.map((bullet, i) => (
                  <li class:list={[bulletClass, i >= entry.printBullets && 'print:hidden']}>{bullet}</li>
                ))}
              </ul>
            </div>
          ))}

          <div>
            <h3 class="font-mono font-bold text-zinc-100 mb-3 print:text-black">
              <span class="text-accent print:text-accent-700">-</span> Projects
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 print:grid-cols-2 print:gap-x-6 print:gap-y-1">
              {projects.map((project) => (
                <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 hover:border-accent-700/60 transition-colors print:bg-white print:border-0 print:p-0">
                  <div class="flex items-baseline justify-between gap-2 mb-2 print:block print:mb-0">
                    <h4 class="font-mono font-bold text-zinc-50 print:text-black print:inline">{project.name}</h4>
                    <span class="hidden print:inline print:text-zinc-700"> - {project.tags.join(', ')}</span>
                    {project.link && (
                      <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-sm font-medium text-accent hover:text-accent-300 flex-shrink-0 print:hidden"
                      >
                        [ Code ]
                      </a>
                    )}
                  </div>
                  <div class="flex flex-wrap gap-2 mb-2 print:hidden">
                    {project.tags.map((tag) => (
                      <span class="px-2 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 font-mono text-xs rounded print:bg-white print:border-zinc-300 print:text-zinc-800">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <p class="text-zinc-400 text-sm leading-relaxed print:hidden">{project.description}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section>
        <h2 class={headingClass}><span class="text-accent">##</span> Education</h2>
        <div class="space-y-6">
          {education.map((entry) => (
            <div>
              <h3 class="font-bold text-zinc-100 print:text-black">{entry.credential}</h3>
              <p class="text-zinc-400 print:text-zinc-700">{entry.school}</p>
              <div class="flex justify-between items-center gap-3 mt-1 mb-2">
                <span class="text-sm text-muted font-mono print:text-zinc-600">{entry.period}</span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium font-mono bg-accent-500/10 border border-accent-700/40 text-accent flex-shrink-0 print:bg-white print:border-accent-300 print:text-accent-700">
                  {entry.badge}
                </span>
              </div>
              {entry.notes.length > 0 && (
                <ul class="resume-bullets list-disc pl-5 marker:text-zinc-600 space-y-1.5 print:marker:text-zinc-500">
                  {entry.notes.map((note) => (
                    <li class={bulletClass}>{note}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class={headingClass}><span class="text-accent">##</span> Additional</h2>
        <p class={bulletClass}>{additional}</p>
      </section>

      <section class="print:hidden">
        <h2 class={headingClass}><span class="text-accent">##</span> Connect</h2>
        <p class="text-zinc-400 text-sm mb-4">
          Open to service desk, IT support, and infrastructure roles.
        </p>
        <a href="mailto:jwirick06@gmail.com" class="inline-block border border-accent text-accent font-mono font-bold py-2 px-6 rounded hover:bg-accent hover:text-zinc-950 transition-colors">
          [ Contact Me ]
        </a>
      </section>

    </div>
  </div>
</MainLayout>
